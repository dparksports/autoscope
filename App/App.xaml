<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="AutoScope.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AutoScope">

    <!-- Dark palette ported verbatim from AutoCommand's App.xaml (fixed dark
         theme in this port). Same resource keys, so ported view XAML keeps
         referencing them via ThemeResource. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ── palette ── -->
            <Color x:Key="BackgroundColor">#171B22</Color>
            <Color x:Key="SurfaceColor">#1F242E</Color>
            <Color x:Key="SurfaceAltColor">#282F3B</Color>
            <Color x:Key="BorderColor">#39414F</Color>
            <Color x:Key="TextPrimaryColor">#F1F4F9</Color>
            <Color x:Key="TextSecondaryColor">#98A2B3</Color>
            <Color x:Key="AccentBlueColor">#3B82F6</Color>
            <Color x:Key="AccentGreenColor">#34D399</Color>
            <Color x:Key="AccentAmberColor">#FBBF24</Color>
            <Color x:Key="AccentRedColor">#F87171</Color>

            <SolidColorBrush x:Key="BackgroundBrush" Color="{ThemeResource BackgroundColor}"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="{ThemeResource SurfaceColor}"/>
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="{ThemeResource SurfaceAltColor}"/>
            <SolidColorBrush x:Key="BorderBrush" Color="{ThemeResource BorderColor}"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{ThemeResource TextPrimaryColor}"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{ThemeResource TextSecondaryColor}"/>
            <SolidColorBrush x:Key="AccentBlueBrush" Color="{ThemeResource AccentBlueColor}"/>
            <SolidColorBrush x:Key="AccentGreenBrush" Color="{ThemeResource AccentGreenColor}"/>
            <SolidColorBrush x:Key="AccentAmberBrush" Color="{ThemeResource AccentAmberColor}"/>
            <SolidColorBrush x:Key="AccentRedBrush" Color="{ThemeResource AccentRedColor}"/>

            <SolidColorBrush x:Key="RowAltBrush" Color="#08FFFFFF"/>
            <SolidColorBrush x:Key="RowHoverBrush" Color="#0CFFFFFF"/>
            <SolidColorBrush x:Key="RowSelectedBrush" Color="#20FFFFFF"/>
            <SolidColorBrush x:Key="GridLineBrush" Color="#18FFFFFF"/>

            <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#3B82F6" Offset="0"/>
                <GradientStop Color="#60A5FA" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="DangerGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#EF4444" Offset="0"/>
                <GradientStop Color="#F87171" Offset="1"/>
            </LinearGradientBrush>

            <!-- ── keyed styles (buttons: CornerRadius is native in WinUI;
                 WPF DropShadowEffect has no equivalent here and is dropped) ── -->
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource PrimaryGradientBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="22"/>
                <Setter Property="Padding" Value="18,9"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
            <Style x:Key="DangerButton" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource DangerGradientBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="22"/>
                <Setter Property="Padding" Value="18,9"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <Style x:Key="CardPanel" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SurfaceBrush}"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}"/>
                <Setter Property="Padding" Value="20"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>

            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>

            <Style x:Key="PageHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
                <Setter Property="Margin" Value="0,0,0,16"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
