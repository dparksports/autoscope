<Page x:Class="AutoScope.Views.BlocksView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      NavigationCacheMode="Required">

    <Grid Margin="16,12,16,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header + actions (WinUI port: DockPanel → Grid) -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Vertical">
                <TextBlock Text="⛔ Blocks" FontSize="20" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextPrimaryBrush}"/>
                <TextBlock Text="Every firewall block this app created — grouped by the Windows service that actually made the connection, not by 'svchost.exe'."
                           FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="RepairBtn" Content="🔎 Repair attribution" Click="RepairBtn_Click"
                        Padding="10,4" FontSize="11" Margin="0,0,8,0"
                        ToolTipService.ToolTip="Recovers the real service behind each 'svchost' block from the 30-day Sysmon archive (network event → PID → command line → service)."/>
                <Button x:Name="RefreshBtn" Content="⟳ Refresh" Click="RefreshBtn_Click"
                        Padding="10,4" FontSize="11"
                        ToolTipService.ToolTip="Reload block records and reconcile with the live firewall rules."/>
            </StackPanel>
        </Grid>

        <!-- Summary chips (WinUI port: WrapPanel → horizontal StackPanel) -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="3" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" Padding="8,3" Margin="0,0,6,4">
                <TextBlock x:Name="TotalChip" FontSize="11" Foreground="{ThemeResource TextPrimaryBrush}"/>
            </Border>
            <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="3" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" Padding="8,3" Margin="0,0,6,4">
                <TextBlock x:Name="ActiveChip" FontSize="11" Foreground="{ThemeResource AccentGreenBrush}"/>
            </Border>
            <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="3" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" Padding="8,3" Margin="0,0,6,4">
                <TextBlock x:Name="PausedChip" FontSize="11" Foreground="{ThemeResource AccentAmberBrush}"/>
            </Border>
            <Border x:Name="HighImpactChipBorder" Background="{ThemeResource SurfaceBrush}" CornerRadius="3" BorderBrush="{ThemeResource AccentRedBrush}" BorderThickness="1" Padding="8,3" Margin="0,0,6,4">
                <TextBlock x:Name="HighImpactChip" FontSize="11" Foreground="{ThemeResource AccentRedBrush}"/>
            </Border>
            <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="3" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" Padding="8,3" Margin="0,0,6,4">
                <TextBlock x:Name="MsInfraChip" FontSize="11" Foreground="{ThemeResource AccentAmberBrush}"/>
            </Border>
            <Border x:Name="UnattributedChipBorder" Background="{ThemeResource SurfaceBrush}" CornerRadius="3" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" Padding="8,3" Margin="0,0,6,4">
                <TextBlock x:Name="UnattributedChip" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}"/>
            </Border>
            <TextBlock x:Name="StatusText" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}"
                       VerticalAlignment="Center" Margin="4,0,0,0"/>
        </StackPanel>

        <!-- Restore guide: a feature broke — which of my blocks is doing it? -->
        <Border x:Name="RestorePanel" Grid.Row="2" Margin="0,0,0,10"
                Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource AccentRedBrush}"
                BorderThickness="1" CornerRadius="4" Padding="10,6" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="RestoreBanner" FontSize="11" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextPrimaryBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="Broken feature:" FontSize="11" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextSecondaryBrush}" Margin="0,0,6,0"/>
                    <ComboBox x:Name="SymptomCombo" MinWidth="300" FontSize="11"
                              SelectionChanged="SymptomCombo_SelectionChanged"/>
                    <Button x:Name="PauseMatchedBtn" Click="PauseMatchedBtn_Click" Margin="8,0,0,0"
                            Padding="10,3" FontSize="11" Content="⏸ Pause these blocks — traffic resumes"
                            ToolTipService.ToolTip="Disables exactly the matched rules. Fully reversible — nothing is deleted."/>
                </StackPanel>
                <ListBox x:Name="MatchList" MaxHeight="150" Margin="0,6,0,0" FontFamily="Consolas" FontSize="10"
                         Background="{ThemeResource BackgroundBrush}" Foreground="{ThemeResource TextPrimaryBrush}"
                         BorderBrush="{ThemeResource BorderBrush}"
                         ToolTipService.ToolTip="Sorted by freshest connection attempt — the block still swallowing traffic is the likely culprit."/>
            </StackPanel>
        </Border>

        <!-- Grouped block list -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="GroupsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,6" Padding="0,0,0,6">
                            <Expander IsExpanded="{Binding Expanded, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                <Expander.Header>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding ImpactGlyph}" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"
                                                       ToolTipService.ToolTip="{Binding ImpactToolTip}"/>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            <Border Background="{ThemeResource SurfaceAltBrush}" CornerRadius="3" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ServiceKey}" FontSize="10" FontFamily="Consolas"
                                                           Foreground="{ThemeResource TextSecondaryBrush}"/>
                                            </Border>
                                            <TextBlock Text="{Binding Summary}" FontSize="11"
                                                       Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="{Binding GroupActionLabel}" Click="GroupToggle_Click"
                                                Tag="{Binding}" Padding="8,2" FontSize="10"
                                                ToolTipService.ToolTip="{Binding GroupActionToolTip}"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </Expander.Header>
                                <StackPanel Margin="24,4,0,8">
                                    <TextBlock Text="{Binding Description}" FontSize="11" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextSecondaryBrush}" Margin="0,0,0,6" MaxWidth="880"/>
                                    <ItemsControl ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="24"/>
                                                            <ColumnDefinition Width="190"/>
                                                            <ColumnDefinition Width="200"/>
                                                            <ColumnDefinition Width="150"/>
                                                            <ColumnDefinition Width="110"/>
                                                            <ColumnDefinition Width="170"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding StatusGlyph}" FontSize="12" VerticalAlignment="Center"
                                                                   ToolTipService.ToolTip="{Binding StatusToolTip}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Target}" FontSize="11" FontFamily="Consolas"
                                                                   Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center"
                                                                   ToolTipService.ToolTip="{Binding TargetToolTip}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding ServiceDisplay}" FontSize="10"
                                                                   Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center"
                                                                   ToolTipService.ToolTip="{Binding ServiceToolTip}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding ClassDisplay}" FontSize="10"
                                                                   Foreground="{Binding ClassBrush}" VerticalAlignment="Center"
                                                                   ToolTipService.ToolTip="{Binding ClassToolTip}"/>
                                                        <TextBlock Grid.Column="4" Text="{Binding CreatedDisplay}" FontSize="10"
                                                                   Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center"
                                                                   ToolTipService.ToolTip="{Binding CreatedToolTip}"/>
                                                        <TextBlock Grid.Column="5" Text="{Binding LastTraffic}" FontSize="10"
                                                                   Foreground="{Binding LastTrafficBrush}" VerticalAlignment="Center"
                                                                   ToolTipService.ToolTip="{Binding LastTrafficToolTip}"/>
                                                        <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <Button Content="{Binding RowActionLabel}" Click="RowToggle_Click" Tag="{Binding}"
                                                                    Padding="8,2" FontSize="10" Margin="0,0,6,0"/>
                                                            <Button Content="Remove" Click="RowRemove_Click" Tag="{Binding}"
                                                                    Padding="8,2" FontSize="10" Foreground="{ThemeResource AccentRedBrush}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
