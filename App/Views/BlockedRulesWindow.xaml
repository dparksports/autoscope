<Window x:Class="AutoScope.Views.BlockedRulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dg="using:CommunityToolkit.WinUI.UI.Controls"
        Title="Blocked Rules — manage all AutoScope firewall blocks">

    <Grid Margin="16" Background="{ThemeResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="200"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Blocked Rules" Style="{ThemeResource PageHeader}"/>
            <TextBlock Text="Every block AutoScope created — grouped by destination owner. Red rows are Microsoft infrastructure or Windows components: blocking them usually breaks updates, notifications or DNS, not threats."
                       Foreground="{ThemeResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,-8,0,0"/>
        </StackPanel>

        <!-- WinUI port: WrapPanel → horizontal StackPanel -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="↻ Refresh" Style="{ThemeResource PrimaryButton}" Padding="10,2" Click="RefreshBtn_Click" Margin="0,0,8,0"/>
            <Button Content="✕ Unblock selected" Style="{ThemeResource PrimaryButton}" Padding="10,2" Click="UnblockSelectedBtn_Click" Margin="0,0,8,0"/>
            <Button x:Name="UnblockMsBtn" Content="✕ Unblock Microsoft-owned ⚠" Style="{ThemeResource PrimaryButton}" Padding="10,2" Click="UnblockMsBtn_Click" Margin="0,0,8,0"/>
            <Button x:Name="ConsolidateBtn" Content="🧹 Consolidate legacy (4→2 rules)" Style="{ThemeResource PrimaryButton}" Padding="10,2" Click="ConsolidateBtn_Click" Margin="0,0,8,0"/>
            <Button Content="⬇ Export CSV" Style="{ThemeResource PrimaryButton}" Padding="10,2" Click="ExportBtn_Click" Margin="0,0,8,0"/>
            <Button x:Name="ReenableBtn" Content="↩ Re-enable all (undo panic)" Style="{ThemeResource PrimaryButton}" Padding="10,2" Click="ReenableBtn_Click" Margin="0,0,8,0"/>
            <Button x:Name="RestoreExceptRiskyBtn" Content="↩ Restore except Microsoft/Windows ⚠" Style="{ThemeResource PrimaryButton}" Padding="10,2" Click="RestoreExceptRiskyBtn_Click" Margin="0,0,8,0"
                    ToolTipService.ToolTip="Re-enables every block EXCEPT Microsoft/CDN and Windows-component targets — the ones that break internet, updates or notifications. Those stay disabled (red rows) until you decide."/>
            <Button x:Name="EnableLogBtn" Content="📋 Enable drop-logging (extra hit source)" Style="{ThemeResource PrimaryButton}" Padding="10,2" Click="EnableLogBtn_Click" Margin="0,0,8,0"
                    ToolTipService.ToolTip="Turns on 'Log dropped packets' for all firewall profiles (4 MB cap, default file). The live feed below already works without it — this adds the firewall's own per-packet log as a second source."/>
            <Button x:Name="RdapBtn" Content="🌐 RDAP-verify unclassified" Style="{ThemeResource PrimaryButton}" Padding="10,2" Click="RdapBtn_Click" Margin="0,0,8,0"
                    ToolTipService.ToolTip="Asks the registries who owns each unclassified target. Results are cached machine-wide (C:\ProgramData\AutoScope\rdap-cache.json) — repeat runs are instant and offline-capable."/>
        </StackPanel>

        <!-- WinUI port: group headers (CollectionViewSource) are dropped —
             rows are sorted by class instead; risky-row red coloring moved
             from a style DataTrigger to LoadingRow in code-behind. -->
        <dg:DataGrid Grid.Row="2" x:Name="RulesGrid" SelectionMode="Extended" IsReadOnly="True"
                     FontFamily="Consolas" FontSize="11" AutoGenerateColumns="False"
                     LoadingRow="RulesGrid_LoadingRow">
            <dg:DataGrid.Columns>
                <dg:DataGridTextColumn Header="Target"    Binding="{Binding Target}"   Width="170"/>
                <dg:DataGridTextColumn Header="Kind"      Binding="{Binding Kind}"     Width="46"/>
                <dg:DataGridTextColumn Header="Owner / class" Binding="{Binding Class}" Width="150"/>
                <dg:DataGridTextColumn Header="Rules"     Binding="{Binding RulesSummary}" Width="90"/>
                <dg:DataGridTextColumn Header="Blocked"   Binding="{Binding CreatedDisplay}" Width="120"/>
                <dg:DataGridTextColumn Header="Hits 1h"   Binding="{Binding HitsDisplay}"   Width="70"/>
                <dg:DataGridTextColumn Header="RDAP owner" Binding="{Binding OwnerDisplay}" Width="170"/>
                <dg:DataGridTextColumn Header="Provenance (also in wf.msc → rule Properties)" Binding="{Binding Note}" Width="*"/>
            </dg:DataGrid.Columns>
        </dg:DataGrid>

        <TextBlock Grid.Row="3" Margin="0,10,0,4" FontSize="12" FontWeight="SemiBold"
                   Foreground="{ThemeResource TextSecondaryBrush}"
                   Text="Recently blocked connects — live (Sysmon EID 3 joined against this list: who is being blocked, right now)"/>

        <dg:DataGrid Grid.Row="4" x:Name="HitsGrid" IsReadOnly="True"
                     FontFamily="Consolas" FontSize="11" AutoGenerateColumns="False"
                     ToolTipService.ToolTip="Windows Firewall blocks connect silently at the kernel — this feed synthesizes the missing signal by joining Sysmon connect attempts against the blocked targets above. Needs Sysmon installed; history persists across restarts.">
            <dg:DataGrid.Columns>
                <dg:DataGridTextColumn Header="Process"    Binding="{Binding Process}"    Width="170"/>
                <dg:DataGridTextColumn Header="PID"        Binding="{Binding Pid}"        Width="60"/>
                <dg:DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="150"/>
                <dg:DataGridTextColumn Header="Match"      Binding="{Binding Match}"      Width="70"/>
                <dg:DataGridTextColumn Header="Attempts"   Binding="{Binding Attempts}"   Width="70"/>
                <dg:DataGridTextColumn Header="First seen" Binding="{Binding FirstSeen}"  Width="130"/>
                <dg:DataGridTextColumn Header="Last seen"  Binding="{Binding LastSeen}"   Width="130"/>
                <dg:DataGridTextColumn Header="Image"      Binding="{Binding Image}"      Width="*"/>
            </dg:DataGrid.Columns>
        </dg:DataGrid>

        <TextBlock Grid.Row="5" x:Name="StatusText" Text="Loading…"
                   Foreground="{ThemeResource TextSecondaryBrush}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
    </Grid>
</Window>
