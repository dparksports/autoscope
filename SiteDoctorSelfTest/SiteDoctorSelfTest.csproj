<Project Sdk="Microsoft.NET.Sdk">

  <!-- Self-test for the "Why is this site slow?" pipeline, now validating the
       F# ENGINES: a C# harness consuming Engines.Diagnosis directly — the
       C#-consumes-F# interop contract is part of what's under test.

       Offline sections drive the fingerprint engine with synthetic rows and
       the verdict rules with synthetic probe reports. The one LIVE section
       binds loopback listeners (no admin, no external network): a TLS server
       that answers handshakes, and a "black hole" that accepts TCP and never
       replies — the exact failure shape the dual-hello probe exists to
       detect, proven detectable at the source. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SiteDoctorSelfTest</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\autocommand-iii\Engines\Engines.Diagnosis\Engines.Diagnosis.fsproj" />
  </ItemGroup>

</Project>
