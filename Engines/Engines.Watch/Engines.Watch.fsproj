<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>AutoScope.Engines.Watch</RootNamespace>
    <Version>2026.10.26.2</Version>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.13" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.13" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Engines.Core\Engines.Core.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Config.fs" />
    <Compile Include="RowModel.fs" />
    <Compile Include="Dns.fs" />
    <Compile Include="TcpTable.fs" />
    <Compile Include="Sniffer.fs" />
    <Compile Include="Capture.fs" />
    <Compile Include="SysmonArchive.fs" />
    <Compile Include="SysmonInstaller.fs" />
    <Compile Include="SysmonWatcher.fs" />
    <Compile Include="SysmonConnect.fs" />
    <Compile Include="SvchostIdentity.fs" />
    <!-- F# port: compile order among the provenance/attribution trio is
         ImageSpawn → TaskAttribution → Provenance — F# needs every type
         before first use: TaskAttribution calls
         ImageSpawnWatcherService.ParseSpawnRecord/IsTaskhostwImage, and
         Provenance.Collect takes TaskLaunchInfo (defined in
         TaskAttribution.fs). C# order (Provenance, TaskAttribution,
         ImageSpawn) was free because C# does not order files. -->
    <Compile Include="ImageSpawn.fs" />
    <Compile Include="TaskAttribution.fs" />
    <Compile Include="Provenance.fs" />
    <Compile Include="TransmissionsCore.fs" />
    <Compile Include="TransmissionsArchive.fs" />
    <Compile Include="TransmissionsPipeline.fs" />
  </ItemGroup>
</Project>
