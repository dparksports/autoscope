<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AutoScope.Engines.Firewall</RootNamespace>
    <Version>2026.10.26.2</Version>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Engines.Core\Engines.Core.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- F# requires explicit compile order -->
    <Compile Include="Naming.fs" />
    <Compile Include="Com.fs" />
    <Compile Include="Service.fs" />
    <Compile Include="Profiles.fs" />
    <Compile Include="Baseline.fs" />
    <Compile Include="Config.fs" />
  </ItemGroup>
</Project>
