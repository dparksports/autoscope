<Project Sdk="Microsoft.NET.Sdk">
  <!-- NetWatch self-test, now validating the F# Engines.Watch: dual-family
       TCP table (LIVE held [::1] connection) + Sysmon archive engine
       (watermark dedupe, day rotation, search, prune, corrupt-line
       tolerance). Archive runs against a temp dir; nothing touches the real
       archive or the live Sysmon channel. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NetWatchSelfTest</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Engines\Engines.Watch\Engines.Watch.fsproj" />
  </ItemGroup>
</Project>
