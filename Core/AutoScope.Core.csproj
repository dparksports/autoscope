<Project Sdk="Microsoft.NET.Sdk">

  <!-- AutoScope.Core — the engine layer ported from AutoCommand
       (Services/Helpers/Models + SecurityEnforcer). UI-framework-free;
       the WinUI app in ..\App is the only front end. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>AutoScope</RootNamespace>
    <AssemblyName>AutoScope.Core</AssemblyName>
    <Product>AutoScope</Product>
    <Version>2026.10.26</Version>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.13" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.13" />
    <!-- Models ported from WPF carry UI types (Brush/Visibility); in WinUI
         those are Windows App SDK projections, so Core references the same
         package the app does. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Engines\Engines.Core\Engines.Core.fsproj" />
    <ProjectReference Include="..\Engines\Engines.Diagnosis\Engines.Diagnosis.fsproj" />
    <ProjectReference Include="..\Engines\Engines.Firewall\Engines.Firewall.fsproj" />
    <ProjectReference Include="..\Engines\Engines.Watch\Engines.Watch.fsproj" />
    <ProjectReference Include="..\Engines\Engines.Bridge\Engines.Bridge.fsproj" />
  </ItemGroup>
</Project>
